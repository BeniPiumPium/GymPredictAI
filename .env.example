# Entorno local: conservar true para desarrollo.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Para publicar, usá el instalador de PUBLICAR_ONLINE.md.
# El instalador genera una clave segura y configura estos valores en el servidor:
# DJANGO_REQUIRE_LOGIN=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tuusuario.pythonanywhere.com
# DJANGO_DB_PATH=/home/tuusuario/.local/share/gympredictai/db.sqlite3

# Meta: configurar por fuente; ver CONECTAR_REDES.md
META_API_VERSION=
META_AD_ID=
META_AD_TOKEN=
META_IG_ID=
META_IG_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=
